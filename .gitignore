# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Source dumps and every derived row live under data/ and never enter git (docs/BRIEF.md rule 2)
/data/
*.xml.gz
*.tar.bz2

# dbt local warehouse and build outputs
.duckdb/
.dbt-state/
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# site exports are regenerated by export_gold from the committed artifacts
docs/site/data/

# Committed on purpose: evaluation artifacts, schemas, method records (aggregates and ids only).
!artifacts/**
# A global ~/.gitignore that ignores `*.sql` would hide the dbt project; keep it self-contained.
!dbt/**/*.sql
