{
  "name": "entity-resolution-decision-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Entity Resolution Decision Lab: a local-first retrospective decision workbench over a frozen matching-benchmark snapshot.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "predev": "node scripts/sync-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-data.mjs",
    "build": "tsc --noEmit && vite build && node scripts/size.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:e2e": "node scripts/sync-data.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "size": "node scripts/size.mjs",
    "sync-data": "node scripts/sync-data.mjs",
    "mock-data": "tsx scripts/mock-lab-data.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
