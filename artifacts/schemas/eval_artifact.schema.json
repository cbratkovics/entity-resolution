{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation artifact (artifact_version 1.0)",
  "description": "artifacts/eval_<method_version>.json: one method's evaluation on the test fold (docs/BRIEF.md 2.9). Every published number is read from here. `metrics` is null until Phase 4 computes it; when present its structure is enforced.",
  "type": "object",
  "required": [
    "artifact_version",
    "method_version",
    "generated_at_utc",
    "input",
    "fold_counts",
    "metric_definitions",
    "metrics"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_version": {"const": "1.0"},
    "method_version": {"type": "string", "enum": ["exact_v1", "rules_v1", "learned_v1"]},
    "generated_at_utc": {"type": "string"},
    "input": {
      "type": "object",
      "required": ["manifest_sha256", "feature_version", "code_commit"],
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {"type": "string"},
        "feature_version": {"type": "string"},
        "code_commit": {"type": "string"}
      }
    },
    "fold_counts": {
      "description": "Per fold: A records, B records, candidate pairs and sampled truth pairs.",
      "type": "object",
      "required": ["fit", "calibrate", "test"],
      "additionalProperties": false,
      "properties": {
        "fit": {"$ref": "#/$defs/fold_count"},
        "calibrate": {"$ref": "#/$defs/fold_count"},
        "test": {"$ref": "#/$defs/fold_count"}
      }
    },
    "metric_definitions": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "metrics": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/metrics"}]
    }
  },
  "$defs": {
    "fold_count": {
      "type": "object",
      "required": ["a_records", "b_records", "candidate_pairs", "truth_pairs"],
      "additionalProperties": false,
      "properties": {
        "a_records": {"type": "integer", "minimum": 0},
        "b_records": {"type": "integer", "minimum": 0},
        "candidate_pairs": {"type": "integer", "minimum": 0},
        "truth_pairs": {"type": "integer", "minimum": 0}
      }
    },
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "tier_metrics": {
      "type": "object",
      "required": ["precision", "recall_labelled", "f1"],
      "additionalProperties": false,
      "properties": {
        "precision": {"$ref": "#/$defs/unit"},
        "recall_labelled": {"$ref": "#/$defs/unit"},
        "f1": {"$ref": "#/$defs/unit"}
      }
    },
    "confusion_cell": {
      "type": "object",
      "required": ["tp", "fp", "fn", "tn"],
      "additionalProperties": false,
      "properties": {
        "tp": {"type": "integer", "minimum": 0},
        "fp": {"type": "integer", "minimum": 0},
        "fn": {"type": "integer", "minimum": 0},
        "tn": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "pair_completeness",
        "at_auto_accept",
        "at_auto_accept_or_review",
        "recall_overall",
        "coverage",
        "coverage_all_folds",
        "tier_shares",
        "calibration",
        "confusion"
      ],
      "additionalProperties": false,
      "properties": {
        "pair_completeness": {
          "type": "object",
          "required": ["union", "per_key"],
          "additionalProperties": false,
          "properties": {
            "union": {"$ref": "#/$defs/unit"},
            "per_key": {"type": "object", "additionalProperties": {"$ref": "#/$defs/unit"}}
          }
        },
        "at_auto_accept": {"$ref": "#/$defs/tier_metrics"},
        "at_auto_accept_or_review": {"$ref": "#/$defs/tier_metrics"},
        "recall_overall": {"$ref": "#/$defs/unit"},
        "coverage": {"$ref": "#/$defs/unit"},
        "coverage_all_folds": {"$ref": "#/$defs/unit"},
        "tier_shares": {
          "type": "object",
          "required": ["auto_accept", "review", "reject"],
          "additionalProperties": false,
          "properties": {
            "auto_accept": {"$ref": "#/$defs/unit"},
            "review": {"$ref": "#/$defs/unit"},
            "reject": {"$ref": "#/$defs/unit"}
          }
        },
        "calibration": {
          "type": "object",
          "required": ["bins", "ece", "brier"],
          "additionalProperties": false,
          "properties": {
            "bins": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": ["lower", "upper", "n", "mean_probability", "observed_rate"],
                "additionalProperties": false,
                "properties": {
                  "lower": {"$ref": "#/$defs/unit"},
                  "upper": {"$ref": "#/$defs/unit"},
                  "n": {"type": "integer", "minimum": 0},
                  "mean_probability": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/unit"}]},
                  "observed_rate": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/unit"}]}
                }
              }
            },
            "ece": {"$ref": "#/$defs/unit"},
            "brier": {"$ref": "#/$defs/unit"}
          }
        },
        "confusion": {
          "type": "object",
          "required": ["auto_accept", "review"],
          "additionalProperties": false,
          "properties": {
            "auto_accept": {"$ref": "#/$defs/confusion_cell"},
            "review": {"$ref": "#/$defs/confusion_cell"}
          }
        }
      }
    }
  }
}
