{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Method version record (record_version 1.0)",
  "description": "artifacts/methods/<method_version>.json: what a method is, its fixed parameters, what it was fitted on and the tier policy it was decided under (docs/BRIEF.md 2.7 and 2.8). Parameters and identifiers only.",
  "type": "object",
  "required": [
    "record_version",
    "method_version",
    "definition",
    "fitted_on",
    "feature_version",
    "parameters",
    "tier_policy",
    "code_commit",
    "created_at_utc"
  ],
  "additionalProperties": false,
  "properties": {
    "record_version": {"const": "1.0"},
    "method_version": {"type": "string", "enum": ["exact_v1", "rules_v1", "learned_v1"]},
    "definition": {"type": "string"},
    "fitted_on": {
      "description": "Folds anything in this method was fitted on; null for a method with nothing fitted.",
      "type": ["object", "null"],
      "additionalProperties": {"type": "string", "enum": ["fit", "calibrate", "test"]}
    },
    "feature_version": {"type": "string"},
    "parameters": {
      "description": "Fixed a priori parameters (rule weights, hyperparameters) and fitted values (thresholds), each named.",
      "type": "object"
    },
    "tier_policy": {
      "type": "object",
      "required": ["auto_accept_min", "review_min", "ambiguity_gap"],
      "additionalProperties": false,
      "properties": {
        "auto_accept_min": {"type": "number", "minimum": 0, "maximum": 1},
        "review_min": {"type": "number", "minimum": 0, "maximum": 1},
        "ambiguity_gap": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "code_commit": {"type": "string"},
    "created_at_utc": {"type": "string"}
  }
}
